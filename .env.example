# TrustGraph AI Environment Configuration Template
DEMO_MODE=true
PROJECT_NAME="TRUSTGRAPH AI"
VERSION="1.0.0"

# Storage Settings
DATA_DIR="./data"
MAX_FILE_SIZE_MB=15

# Optional Database Connections (Falls back to embedded JSON engine if unavailable)
MONGODB_URI="mongodb://localhost:27017/trustgraph"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"

# Security
SECRET_KEY="replace-this-with-a-secure-random-key-in-production"
