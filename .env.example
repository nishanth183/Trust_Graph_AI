# TrustGraph AI Backend Environment Configuration Template

# Server Configuration
PORT=8000
DEMO_MODE=true
PROJECT_NAME="TRUSTGRAPH AI"
VERSION="1.0.0"

# CORS / Deployed Frontend URL (e.g., https://trustgraph-ai.vercel.app)
FRONTEND_URL=
ALLOWED_ORIGINS=

# Storage & File Limits
DATA_DIR="./data"
MAX_FILE_SIZE_MB=15

# Persistent Database (Dual-Engine: Uses local JSON storage by default, or auto-syncs with MongoDB Atlas in production)
MONGODB_URI="mongodb://localhost:27017/trustgraph"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"

# Security (JWT token signing & authentication)
SECRET_KEY="replace-this-with-a-secure-random-key-in-production"


